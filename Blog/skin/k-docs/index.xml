<?xml version="1.0" encoding="utf-8"?>
<skin>
  <information>
    <name>K-docs</name>
    <version>1.0</version>
    <description>
      <![CDATA[코드 위주 기술 블로그용 문서형 스킨. 왼쪽 카테고리, 가운데 본문, 오른쪽 목차. 라이트/다크(자동·선택), 나눔고딕, VS2022 다크 코드 블록.]]>
    </description>
    <license>
      <![CDATA[개인 블로그(K-프로그래밍)용으로 만들었습니다. 자유롭게 수정할 수 있습니다.]]>
    </license>
  </information>
  <author>
    <name>K-프로그래밍</name>
    <homepage>https://k-program.tistory.com</homepage>
    <email></email>
  </author>
  <default>
    <recentEntries>5</recentEntries>
    <recentComments>5</recentComments>
    <recentTrackbacks>5</recentTrackbacks>
    <itemsOnGuestbook>10</itemsOnGuestbook>
    <tagsInCloud>30</tagsInCloud>
    <sortInCloud>1</sortInCloud>
    <expandComment>1</expandComment>
    <expandTrackback>0</expandTrackback>
    <lengthOfRecentNotice>25</lengthOfRecentNotice>
    <lengthOfRecentEntry>30</lengthOfRecentEntry>
    <lengthOfRecentComment>30</lengthOfRecentComment>
    <lengthOfRecentTrackback>30</lengthOfRecentTrackback>
    <lengthOfLink>30</lengthOfLink>
    <showListOnCategory>1</showListOnCategory>
    <showListOnArchive>1</showListOnArchive>
    <entriesOnPage>10</entriesOnPage>
    <entriesOnList>15</entriesOnList>
    <commentMessage>
      <none>댓글이 없습니다.</none>
      <single>댓글 &lt;span class="cnt"&gt;하나&lt;/span&gt;</single>
    </commentMessage>
    <trackbackMessage>
      <none>받은 트랙백이 없고</none>
      <single>트랙백이 &lt;span class="cnt"&gt;하나&lt;/span&gt;이고</single>
    </trackbackMessage>
    <tree>
      <color>465065</color>
      <bgColor>ffffff</bgColor>
      <activeColor>2563a8</activeColor>
      <activeBgColor>e8f0fa</activeBgColor>
      <labelLength>30</labelLength>
      <showValue>1</showValue>
    </tree>
    <contentWidth>780</contentWidth>
  </default>
  <variables>
    <variablegroup name="화면">
      <variable>
        <name>default-theme</name>
        <label>기본 테마</label>
        <description>방문자가 직접 고르기 전의 테마. 자동은 PC·폰의 다크 모드 설정을 따른다.</description>
        <type>SELECT</type>
        <option><![CDATA[ [ {"name":"auto","label":"자동 (OS 설정)","value":"auto"}, {"name":"light","label":"라이트","value":"light"}, {"name":"dark","label":"다크","value":"dark"} ] ]]></option>
        <default>auto</default>
      </variable>
      <variable>
        <name>accent-color</name>
        <label>라이트 테마 포인트 색</label>
        <description>다크 테마는 Claude 데스크톱 주황(#d97757)으로 고정</description>
        <type>COLOR</type>
        <default>#2563a8</default>
      </variable>
    </variablegroup>
    <variablegroup name="홈 소개">
      <variable>
        <name>intro-role</name>
        <label>직무 한 줄</label>
        <type>STRING</type>
        <default>FA 비전 검사 소프트웨어 엔지니어</default>
      </variable>
      <variable>
        <name>intro-title</name>
        <label>소개 제목 (비우면 블로그 이름)</label>
        <type>STRING</type>
        <default>현장 C# 기록</default>
      </variable>
      <variable>
        <name>intro-desc</name>
        <label>소개 문장 (비우면 블로그 설명)</label>
        <type>STRING</type>
        <default>카메라·PLC·조명이 붙은 검사 장비 프로그램을 만들고 고칩니다. 현장에서 부딪힌 문제와 다시 손으로 쳐 본 코드를 정리합니다.</default>
      </variable>
      <variable>
        <name>intro-skills</name>
        <label>기술 (쉼표로 구분)</label>
        <type>STRING</type>
        <default>C#, .NET Framework, WinForms, OpenCvSharp, PLC TCP/IP, 멀티스레드</default>
      </variable>
      <variable>
        <name>github-url</name>
        <label>GitHub 주소 (비우면 버튼 숨김)</label>
        <type>STRING</type>
        <default>https://github.com/pjbmylove2/MiniSight.Katas</default>
      </variable>
      <variable>
        <name>portfolio-url</name>
        <label>포트폴리오 주소 (비우면 버튼 숨김)</label>
        <type>STRING</type>
        <default></default>
      </variable>
    </variablegroup>
    <variablegroup name="지금 연재 중">
      <variable>
        <name>now-title</name>
        <label>연재 제목 (비우면 카드 숨김)</label>
        <type>STRING</type>
        <default>C# 기초 체력 B01~B14</default>
      </variable>
      <variable>
        <name>now-desc</name>
        <label>연재 설명</label>
        <type>STRING</type>
        <default>키워드 하나에 콘솔 예제 하나. null부터 Timer 카메라까지.</default>
      </variable>
      <variable>
        <name>now-current</name>
        <label>공개한 편 수</label>
        <type>STRING</type>
        <default>1</default>
      </variable>
      <variable>
        <name>now-total</name>
        <label>전체 편 수</label>
        <type>STRING</type>
        <default>14</default>
      </variable>
      <variable>
        <name>now-link</name>
        <label>연재 카테고리 주소</label>
        <type>STRING</type>
        <default>/category</default>
      </variable>
    </variablegroup>
    <variablegroup name="시리즈 카드">
      <variable><name>series1-title</name><label>1번 제목 (비우면 시리즈 영역 숨김)</label><type>STRING</type><default>C# 기초 체력</default></variable>
      <variable><name>series1-tag</name><label>1번 꼬리표</label><type>STRING</type><default>B01~B14</default></variable>
      <variable><name>series1-desc</name><label>1번 설명</label><type>STRING</type><default>키워드 하나에 콘솔 예제 하나.</default></variable>
      <variable><name>series1-link</name><label>1번 주소</label><type>STRING</type><default>/category</default></variable>
      <variable><name>series2-title</name><label>2번 제목 (비우면 숨김)</label><type>STRING</type><default>C# Framework 만들기</default></variable>
      <variable><name>series2-tag</name><label>2번 꼬리표</label><type>STRING</type><default>Framework</default></variable>
      <variable><name>series2-desc</name><label>2번 설명</label><type>STRING</type><default>카메라·PLC를 감싸는 구조와 상태 머신.</default></variable>
      <variable><name>series2-link</name><label>2번 주소</label><type>STRING</type><default>/category</default></variable>
      <variable><name>series3-title</name><label>3번 제목 (비우면 숨김)</label><type>STRING</type><default>머신비전 기초</default></variable>
      <variable><name>series3-tag</name><label>3번 꼬리표</label><type>STRING</type><default>Vision</default></variable>
      <variable><name>series3-desc</name><label>3번 설명</label><type>STRING</type><default>구성 요소와 검사·측정·판독·위치 보정.</default></variable>
      <variable><name>series3-link</name><label>3번 주소</label><type>STRING</type><default>/category</default></variable>
    </variablegroup>
  </variables>
</skin>
